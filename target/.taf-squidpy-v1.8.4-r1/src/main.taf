<taf-app:container:ghcr.io/taffish/squidpy:1.8.4-r1$@[docker/podman: $(taf_sqauto="${TAFFISH_SQUIDPY_DATASET_AUTO_MOUNT-1}"; taf_sqroot=""; if test "$taf_sqauto" = 0; then exit 0; elif test "$taf_sqauto" != 1; then printf >&2 'taf-squidpy: DATASET_AUTO_MOUNT accepts only 0 or 1\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; if test "${TAFFISH_SQUIDPY_DATASET_PATH+x}" = x; then taf_sqroot="${TAFFISH_SQUIDPY_DATASET_PATH}"; if test -z "$taf_sqroot"; then printf >&2 'taf-squidpy: explicit DATASET_PATH is empty\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; else for taf_sqcandidate in "${HOME}/.local/share/taffish/datasets/squidpy" /usr/local/share/taffish/datasets/squidpy /opt/taffish/datasets/squidpy; do if test -e "$taf_sqcandidate" || test -L "$taf_sqcandidate"; then taf_sqroot="$taf_sqcandidate"; break; fi; done; fi; if test -n "$taf_sqroot"; then if test "$(printf '%s' "$taf_sqroot" | LC_ALL=C tr -cd 'a-zA-Z0-9_./@+=-')" != "$taf_sqroot"; then printf >&2 'taf-squidpy: automatic mount path contains unsupported characters; use documented manual bind\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; taf_sqroot="$(cd "$taf_sqroot" 2>/dev/null && { pwd -P; printf X; })"; taf_sqroot="${taf_sqroot%X}"; taf_sqroot="${taf_sqroot%?}"; if test -z "$taf_sqroot" || test "$taf_sqroot" = / || test ! -d "$taf_sqroot" || test "$(printf '%s' "$taf_sqroot" | LC_ALL=C tr -cd 'a-zA-Z0-9_./@+=-')" != "$taf_sqroot"; then printf >&2 'taf-squidpy: dataset root is missing, invalid, or unsafe\n'; printf -- '--taffish-squidpy-invalid-root'; else printf -- '--volume=%s:/datasets/squidpy:ro --env=TAFFISH_SQUIDPY_DATASET_ACTIVE=1' "$taf_sqroot"; fi; fi)][apptainer: $(taf_sqauto="${TAFFISH_SQUIDPY_DATASET_AUTO_MOUNT-1}"; taf_sqroot=""; if test "$taf_sqauto" = 0; then exit 0; elif test "$taf_sqauto" != 1; then printf >&2 'taf-squidpy: DATASET_AUTO_MOUNT accepts only 0 or 1\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; if test "${TAFFISH_SQUIDPY_DATASET_PATH+x}" = x; then taf_sqroot="${TAFFISH_SQUIDPY_DATASET_PATH}"; if test -z "$taf_sqroot"; then printf >&2 'taf-squidpy: explicit DATASET_PATH is empty\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; else for taf_sqcandidate in "${HOME}/.local/share/taffish/datasets/squidpy" /usr/local/share/taffish/datasets/squidpy /opt/taffish/datasets/squidpy; do if test -e "$taf_sqcandidate" || test -L "$taf_sqcandidate"; then taf_sqroot="$taf_sqcandidate"; break; fi; done; fi; if test -n "$taf_sqroot"; then if test "$(printf '%s' "$taf_sqroot" | LC_ALL=C tr -cd 'a-zA-Z0-9_./@+=-')" != "$taf_sqroot"; then printf >&2 'taf-squidpy: automatic mount path contains unsupported characters; use documented manual bind\n'; printf -- '--taffish-squidpy-invalid-root'; exit 0; fi; taf_sqroot="$(cd "$taf_sqroot" 2>/dev/null && { pwd -P; printf X; })"; taf_sqroot="${taf_sqroot%X}"; taf_sqroot="${taf_sqroot%?}"; if test -z "$taf_sqroot" || test "$taf_sqroot" = / || test ! -d "$taf_sqroot" || test "$(printf '%s' "$taf_sqroot" | LC_ALL=C tr -cd 'a-zA-Z0-9_./@+=-')" != "$taf_sqroot"; then printf >&2 'taf-squidpy: dataset root is missing, invalid, or unsafe\n'; printf -- '--taffish-squidpy-invalid-root'; else printf -- '--bind=%s:/datasets/squidpy:ro --env=TAFFISH_SQUIDPY_DATASET_ACTIVE=1' "$taf_sqroot"; fi; fi)]>
python ::*ARGV*::
